# ==========================================
# MUSE2API 配置环境变量示例
# 复制为 .env 即可生效: cp .env.example .env
# ==========================================

# [选填] 管理与 API 鉴权密钥（以 m2a_ 开头）。
# 建议留空：程序首次启动时会自动生成一个高强度随机密钥并写入 .env、打印到控制台日志。
# 注意：不要填入示例里的占位 key，程序会把已知的占位/默认 key 视为"已泄露"并自动替换。
MUSE2API_KEY=

# 服务监听地址与端口（Docker 容器内需设为 0.0.0.0）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# 外部公开访问地址（供下游客户端接入及管理页拼接使用，如 https://api.yourdomain.com）
# 留空时，管理页面将自动使用当前浏览器访问的主机与端口
MUSE2API_PUBLIC_BASE=

# Chromium 浏览器可执行文件路径
# Linux/Docker 通常为 /usr/bin/chromium 或 /usr/bin/chromium-browser
# Windows 本地运行可设为 Chrome 完整路径或留空自动查找
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP 远程调试通信端口
MUSE2API_CDP_PORT=19210

# 任务超时控制（单位：秒）
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# 是否对后台禁用的账号执行自动保活（0=关闭，1=开启）
# 开启后已禁用账号仍会执行静默保活与会话续期，但不会被路由参与正常生成与对话
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Tự động dọn thư mục data/media (mặc định 0 = TẮT, không xóa gì).
# Xóa file cũ hơn N ngày (chỉ dọn khi > 0):
MUSE2API_MEDIA_RETENTION_DAYS=0
# Chỉ giữ lại N file mới nhất, xóa phần dôi ra (chỉ dọn khi > 0):
MUSE2API_MEDIA_MAX_FILES=0

# ==========================================
# Cấu hình Novagate/Shopee (dùng cho tab tạo video hàng loạt từ Database sản phẩm)
# Để trống nếu không dùng tính năng này. KHÔNG điền key thật vào file .env.example.
# ==========================================
SHOPEE_SERVER_URL=
SHOPEE_API_KEY=
SHOPEE_CLIENT_ID=
# Thư mục lưu video đầu ra (để trống -> <thư mục dự án>/output)
SHOPEE_OUT_DIR=
