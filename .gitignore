# ====================================================================
# MuseAI Video Studio - Git Ignore
# ====================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
*.egg

# Environment & Credentials
.env
.env.local
root/.env
root/.env.local
*.key
*.pem

# Runtime & User Data
root/data/accounts.json
root/data/tasks.json
root/data/.installed_sha
root/data/debug-*.json
root/data/media/*
!root/data/media/.gitkeep
root/data/downloads/*
!root/data/downloads/.gitkeep
root/data/shopee_images_cache/*
!root/data/shopee_images_cache/.gitkeep
root/data/mail_accounts.txt
root/chrome-profile/
root/muse2api-profiles/

# Sensitive user data (chứa email, mật khẩu, cookie, proxy)
*-MUSE.txt
*MUSE*.txt
*khoa*.txt
muse*lỗi*.txt
root/data/auto_login_results.json
root/data/auto_login_success_cookies.txt
root/data/proxy_pool.json
root/data/shopee_settings.json
root/data/shopee_clip_cache.json
root/data/shopee_blacklist.json
root/data/tmp*

# Developer Admin Scripts (chỉ giữ trên máy chính, không đưa lên GitHub)
upload-github.bat
root/upload-github.bat
root/tools/upload_github.py

# Logs & Backups
log.txt*
*.log
*.bak
*.bak*
*.swp
*~

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Archives
*.zip
*.tar.gz
*.tar

root/data/proxy_settings.json
root/data/tasks.archive-*.json
root/data/stuck_debug/

# File nen ban sao luu (co the chua .env, accounts.json, cookie) - KHONG BAO GIO dua len GitHub
*.rar
*.zip
*.7z

# Anh tam khi ghep Outro 12s
root/data/temp_outro_*
