# ==========================================
# Mẫu cấu hình biến môi trường MUSE2API
# Sao chép thành .env để áp dụng: cp .env.example .env
# ==========================================

# [Tuỳ chọn] Khoá xác thực Quản trị & API (bắt đầu bằng m2a_).
# Khuyên để trống: lần đầu khởi động chương trình sẽ tự sinh khoá ngẫu nhiên mạnh, ghi vào .env và in ra log.
# Lưu ý: không điền khoá mẫu/placeholder, chương trình sẽ coi khoá mẫu đã biết là "bị lộ" và tự thay thế.
MUSE2API_KEY=

# Địa chỉ và cổng lắng nghe của dịch vụ (trong Docker container cần đặt 0.0.0.0)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Địa chỉ truy cập công khai từ bên ngoài (dùng cho client kết nối và hiển thị trên trang quản trị, vd: https://api.yourdomain.com)
# Khi để trống, trang quản trị sẽ tự dùng host và port đang truy cập trên trình duyệt
MUSE2API_PUBLIC_BASE=

# Đường dẫn file thực thi trình duyệt Chromium
# Trên Linux/Docker thường là /usr/bin/chromium hoặc /usr/bin/chromium-browser
# Trên Windows chạy cục bộ có thể đặt đường dẫn đầy đủ tới Chrome hoặc để trống để tự dò tìm
MUSE2API_CHROMIUM=/usr/bin/chromium

# Cổng giao tiếp gỡ lỗi từ xa CDP
MUSE2API_CDP_PORT=19210

# Thời gian chờ tối đa của tác vụ (đơn vị: giây)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Có tự động giữ sống (keep-alive) cho các tài khoản đang bị tắt không (0=tắt, 1=bật)
# Khi bật, tài khoản đang tắt vẫn được giữ phiên ngầm nhưng không được chọn để tạo ảnh/video hay hội thoại
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Tự động dọn thư mục data/media (mặc định 0 = TẮT, không xóa gì).
# Xóa file cũ hơn N ngày (chỉ dọn khi > 0):
MUSE2API_MEDIA_RETENTION_DAYS=0
# Chỉ giữ lại N file mới nhất, xóa phần dôi ra (chỉ dọn khi > 0):
MUSE2API_MEDIA_MAX_FILES=0

# ==========================================
# Cấu hình Novagate/Shopee (dùng cho tab tạo video hàng loạt từ Database sản phẩm)
# Để trống nếu không dùng tính năng này. KHÔNG điền key thật vào file .env.example.
# ==========================================
SHOPEE_SERVER_URL=
SHOPEE_API_KEY=
SHOPEE_CLIENT_ID=
# Thư mục lưu video đầu ra (để trống -> <thư mục dự án>/output)
SHOPEE_OUT_DIR=
